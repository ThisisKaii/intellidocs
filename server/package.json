    "cors": "^2.8.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.0",
    "form-data": "^4.0.6",
    "googleapis": "^173.0.0",
    "googleapis-common": "8.0.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "redis": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
