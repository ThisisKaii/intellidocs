    { "group": "none", "message": "make the 2nd paragraph longer", "expect": { "kind": ["none"] } },
    { "group": "none", "message": "add a table of contents", "expect": { "kind": ["none"] } },
    { "group": "none", "message": "share this doc with my adviser", "expect": { "kind": ["none"] } }
  ]
