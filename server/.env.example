#Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

#Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

#Python ML API
# Read by server/src/ai/bridge/pythonBridge.ts. ML_API_URL wins, then
# PYTHON_API_URL. ML_SERVICE_URL is NOT read and has no effect.
ML_API_URL=http://localhost:8000

#MCP Server
MCP_API_PORT=

#Environment
NODE_ENV=
JWT_SECRET=

#Server
PORT=

#AI
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional extra AI profiles (2..9): failover for the chatbot and extra judges for the council.
# Providers: gemini, nvidia, groq, openrouter, mistral. Keys may be comma-separated.
AI_PROVIDER_2=
AI_API_KEY_2=
AI_MODEL_2=
AI_PROVIDER_3=
AI_API_KEY_3=
AI_MODEL_3=
# Optional: pin a council judge to a profile number (default: specialists round-robin, arbiter on 1).
# COUNCIL_STYLOMETRIC_LINGUIST_PROFILE=
# COUNCIL_FORENSIC_HISTORIAN_PROFILE=
# COUNCIL_ATTRIBUTION_SCHOLAR_PROFILE=
# COUNCIL_PARAPHRASE_DETECTIVE_PROFILE=
# COUNCIL_SYNTHESIZER_ARBITER_PROFILE=
COUNCIL_ARBITER_PROFILE=
COUNCIL_JUDGE_TIMEOUT_SECONDS=

#Google API
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match a redirect URI registered on the Google OAuth client exactly,
# including scheme and trailing path. Register both of these:
#   http://localhost:3000/drive/callback
#   https://api.intellidocs-silk.vercel.app/drive/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/drive/callback
# Signs the OAuth state parameter that binds a callback to the user who started
# it. Generate with: openssl rand -hex 32
DRIVE_OAUTH_STATE_SECRET=
# Google's file picker (Drive import): an API key restricted to the Picker API and your
# site's referrers, and the Google Cloud project number.
GOOGLE_PICKER_API_KEY=
GOOGLE_APP_ID=

#Frontend
FRONTEND_URL=http://localhost:5173
