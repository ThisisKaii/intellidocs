+/** Whether a table is inside, around or touched by the range (ancestors of the range count). */
+function rangeHasTable(doc, from, to) {
+    const size = doc.content.size;
+    const start = Math.max(0, Math.min(from, size));
+    const end = Math.max(start, Math.min(Math.max(to, start + 1), size));
+    let hit = false;
+    doc.nodesBetween(start, end, (node) => {
+        if (hit)
