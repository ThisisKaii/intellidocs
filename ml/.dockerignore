# Build context is the repository root, so ignore everything that is not ML code.
# The compose file mounts ./ml/models and ./ml/datasets as volumes, so the image
# never needs to carry generated weights or corpora.
**/__pycache__
**/*.pyc
**/.pytest_cache
.venv
venv
env
.git
.gitignore
.env
.env.*
!.env.example
tests
pytest.ini
models/
datasets/
data/
reports/
*.pkl
*.pt
*.onnx
# Render's free plan has no persistent disk, so the two git-tracked models ship in the image.
# Later rules win, so these re-include them past the models/ and *.pkl exclusions above.
!models/base_model.pkl
!models/grammar_model.pkl
*.log
Dockerfile
.dockerignore
README.md
