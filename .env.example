# This file documents all environment variables needed
# Copy to .env.local (frontend) or .env (backend/ml) and fill in your values

# === SUPABASE ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Transaction pooler (Supabase connection pooler for production traffic) e.g. postgresql://postgres.your-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
SUPABASE_POOLER_URL=

# === REDIS ===
# Local (package `redis`): Redis client used when UPSTASH vars are absent.
REDIS_URL=redis://localhost:6379
# Upstash REST (preferred for serverless / Render scale-out). Enables the
# document read cache in documentModel.ts automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === PORTS ===
FRONTEND_PORT=5173
BACKEND_PORT=3000
ML_PORT=8000
MCP_PORT=3001

# === KEYS ===
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# === Google OAuth2 (Drive import + native Google Docs) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public callback: http://localhost:3000/drive/callback
GOOGLE_REDIRECT_URI=

# === AI ===
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key
AI_MODEL=gemini-2.0-flash

# === ML ===
ML_API_URL=http://localhost:8000
# Supabase Storage bucket for per-user models (defaults to `user-models`)
USER_MODEL_BUCKET=user-models
# Optional directory override for the ML 24h temp cache
ML_CACHE_DIR=

# === CORS ===
FRONTEND_URL=http://localhost:5173

# === ARCJET ===
ARCJET_KEY=your_arcjet_key

# === NODE ===
NODE_ENV=development

# === AI QUOTA ===
AI_REQUEST_QUOTA_LIMIT=100
AI_REQUEST_QUOTA_WINDOW_SECONDS=3600
